		"@supabase/supabase-js": "^2.50.2",
		"better-auth": "1.3.27",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"convex": "^1.27.4",
		"convex-svelte": "^0.0.11",
		"cookie": "^1.0.2",
		"d3-force": "^3.0.0",
		"flexsearch": "^0.8.205",
		"hitbox": "link:@atlaskit/pragmatic-drag-and-drop/hitbox",
		"idb": "^8.0.3",
		"jose": "^6.1.0",
		"js-yaml": "^4.1.0",
		"jszip": "^3.10.1",
		"lucide-react": "^0.554.0",
		"tailwind-merge": "^3.3.1",
		"uuid": "^11.1.0"
	},
	"pnpm": {
		"overrides": {
			"@atlaskit/pragmatic-drag-and-drop-hitbox": "1.1.0"
		}
	}
}