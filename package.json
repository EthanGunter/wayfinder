{
	"name": "wayfinder",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"prebuild": "npx convex deploy",
		"dev": "concurrently \"pnpx convex dev --local\" \"vite dev\"",
		"deploy:preview": "pnpx convex deploy --env-file .env.preview",
		"deploy:prod": "pnpx convex deploy --env-file .env.prod",
		"host": "vite dev --host",
		"build": "vite build --mode prod",
		"build:mobile": "vite build --mode mobile && npx cap sync",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest",
		"test:once": "vitest run",
		"test:debug": "vitest --inspect-brk --no-file-parallelism",
		"test:coverage": "vitest run --coverage --coverage.reporter=text"
	},
	"devDependencies": {
		"@capacitor-community/sqlite": "^7.0.0",
		"@capacitor/android": "^7.4.0",
		"@capacitor/cli": "^7.4.0",
		"@capacitor/core": "^7.4.0",
		"@capacitor/filesystem": "^7.1.1",
		"@capacitor/ios": "^7.4.0",
		"@edge-runtime/vm": "^5.0.0",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@iconify/svelte": "^5.0.0-beta.1",
		"@internationalized/date": "^3.8.2",
		"@lucide/svelte": "^0.544.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/adapter-vercel": "^5.10.2",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/d3-force": "^3.0.10",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^24.7.0",
		"@typescript-eslint/parser": "^8.34.1",
		"@xyflow/svelte": "^1.4.2",
		"bits-ui": "^2.11.4",
		"concurrently": "^9.2.1",
		"convex-test": "^0.0.38",
		"elkjs": "^0.10.0",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-neverthrow": "^1.1.4",
		"eslint-plugin-svelte": "^3.0.0",
		"fake-indexeddb": "^6.0.1",
		"globals": "^16.0.0",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"sass": "^1.89.2",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-sonner": "^1.0.6",
		"tailwind-variants": "^3.1.1",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.3.6",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^6.2.6",
		"vite-plugin-devtools-json": "^0.2.0",
		"vitest": "^3.2.4",
		"vitest-mock-extended": "^3.1.0"
	},
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^1.7.7",
		"@atlaskit/pragmatic-drag-and-drop-hitbox": "1.1.0",
		"@auth/core": "^0.37.0",
		"@convex-dev/better-auth": "^0.9.3",
		"@convex-dev/migrations": "^0.2.9",
		"@convex-dev/resend": "^0.1.13",
		"@humanspeak/svelte-markdown": "^0.8.13",
		"@milkdown/core": "^7.17.1",
		"@milkdown/kit": "^7.17.1",
		"@milkdown/plugin-listener": "^7.17.1",
		"@milkdown/plugin-tooltip": "^7.17.1",
		"@milkdown/preset-commonmark": "^7.17.1",
		"@milkdown/preset-gfm": "^7.17.1",
		"@milkdown/prose": "^7.17.1",
		"@milkdown/theme-nord": "^7.17.1",
