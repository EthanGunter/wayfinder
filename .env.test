SITE_URL=http://localhost:5173
AUTH_SUFFIX=/api/auth
AUTH_URL=${SITE_URL}${AUTH_SUFFIX}


CONVEX_DEPLOYMENT=N/A
CONVEX_URL=N/A
CONVEX_SITE_URL=N/A


# Expose to svelte client
PUBLIC_SITE_URL=${SITE_URL}
PUBLIC_AUTH_URL=${AUTH_URL}
PUBLIC_CONVEX_URL=${CONVEX_URL}
PUBLIC_CONVEX_SITE_URL=${CONVEX_SITE_URL}